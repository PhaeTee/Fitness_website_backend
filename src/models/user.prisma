model User {
    id String @id @default(uuid())
    email String @unique
    password String 
    name String
    profile Profile?
    subscriptions Subscription[]
    payments Payment[]
}

model Profile {
    id String @id @default(uuid())
    phone_number String
    country String
    state String
    userId String @unique
    user User @relation(fields: [userId], references: [id])
}

